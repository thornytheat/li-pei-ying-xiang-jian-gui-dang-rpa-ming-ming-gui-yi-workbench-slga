# 复制为 .env 后使用：cp .env.example .env
COMPOSE_PROJECT_NAME=docflow
FRONTEND_PORT=18253
BACKEND_PORT=19253
DB_PORT=17753
DB_NAME=docflow
DB_USER=docflow
DB_PASSWORD=change_me_in_production
JWT_SECRET=change_me_in_production
REDIS_URL=redis://redis:6379/0
SEED_DEMO=true
# 内网/离线机器可改为 https://registry.npmjs.org
NPM_REGISTRY=https://registry.npmmirror.com
RATE_LIMIT_RUN_PER_MINUTE=8
RATE_LIMIT_CONFIRM_PER_MINUTE=40
LOGIN_ATTEMPT_PER_MINUTE=12
# 投件源故障注入（演示来源超时/不可达；留空=三来源正常）
# 例（邮箱读取超时）：SOURCE_FAULTS={"mailbox":{"reason":"read_timeout","detail":"imap 连接 5s 超时"}}
# reason 可选：read_timeout / not_mounted / permission_denied / unknown_error；来源代码：shared_drive / mailbox / portable
SOURCE_FAULTS=
# 也可指向容器内 JSON 文件，改动文件即可切换故障，无需重启：SOURCE_FAULT_FILE=/app/config/source_faults.json
SOURCE_FAULT_FILE=
